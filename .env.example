HOST=127.0.0.1
PORT=3000
# Used only when first creating the DB; change later in Admin > Settings.
ADMIN_PASSWORD=1234
PAYMENT_API_KEY=replace-with-a-random-key-at-least-24-characters
HARDWARE_MODE=mock
DEMO_PAYMENTS=true
# local or omise_test. Test mode requires mock hardware and disables demo payments.
PAYMENT_PROVIDER=local
# Server-only test secret from the Omise dashboard.
OMISE_SECRET_KEY=
SERIAL_PATH=/dev/serial/by-id/replace-with-your-controller
DB_PATH=./data/vending-v2.sqlite
